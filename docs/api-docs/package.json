{
  "name": "@inngest/api-docs",
  "description": "Inngest API Documentation",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm generate && tsc --noEmit && vite build --mode=production",
    "generate": "tsx scripts/generate-docs.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.1",
    "fumadocs-core": "^16.0.0",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-openapi": "11.3.4",
    "fumadocs-ui": "^16.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-config": "0.4.0",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.24.0"
}
